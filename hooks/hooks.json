{
  "description": "Rejects Edit, Write and MultiEdit calls that add low-value comments, and verbose git commit messages.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_comments.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_comments.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
